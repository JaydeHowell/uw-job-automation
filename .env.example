# Get your API key from Google Studio and add it in here
GEMINI_API_KEY=your_gemini_api_key_here
# Place the absolute path to your profile text or md file here
# Otherwise, defaults to /profile/profile.md
# If using the default, it is still better to get the absolute path to your profile and paste it here
# The default path may have trouble resolving if the program is not run from the source folder
PROFILE_PATH=""